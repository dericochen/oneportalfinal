# Salin ke .env.local lalu isi. JANGAN commit .env.local (sudah di .gitignore).

# --- Publik (boleh terlihat di browser; akses data dijaga RLS) ---
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) atau anon key lama
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# URL situs (untuk QR resi & tautan). Lokal: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Peta memakai OpenFreeMap (OpenStreetMap), gratis dan tanpa kunci API: tidak ada variabel peta.

# --- RAHASIA: hanya server & mesin tim. Jangan pernah diberi awalan NEXT_PUBLIC_ ---
# Supabase > Project Settings > API > service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=
# Supabase > Connect > Session pooler (dengan kata sandi database). Hanya untuk npm run db:*
SUPABASE_DB_URL=postgresql://postgres.xxxxxxxxxxxx:KATA_SANDI@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# Minimal 32 karakter acak. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
